<Project Sdk="Microsoft.NET.Sdk">

  <!-- matpool: Verse.MaterialPool's cache key, exercised as real code.
       References the shipped Assembly-CSharp (Verse) and a minimal UnityStubs stand-in
       (Stub/) instead of the Waylith engine, so MatFrom / MaterialRequest.Equals run for
       real with no game, no GPU, no Unity and no engine assemblies. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MatPool</AssemblyName>
    <RootNamespace>MatPool</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Stub/**" />
    <ProjectReference Include="Stub/Stub.csproj" />
    <Reference Include="Assembly-CSharp">
      <HintPath>../dlls/Assembly-CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- ilsites: finds, in the SHIPPED IL, every call site of the pack predicates that decide
       "is this asset in the pack?" plus every Texture2D.LoadFromFile call with its argument
       count, so the report can name the caller instead of guessing it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Ilsites</AssemblyName>
    <RootNamespace>Ilsites</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.5" />
  </ItemGroup>

</Project>

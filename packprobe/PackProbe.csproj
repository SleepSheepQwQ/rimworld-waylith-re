<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Startup hook that asks the real VFS what names it produces for the shipped asset packs.
    Nothing here re-implements resolution: it calls Verse.ContentFinder and GraphicDatabase,
    the same two entry points Graphic_* uses, and prints what comes back.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PackProbe</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>../../dlls/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>../../dlls/UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>../../dlls/Waylith.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>

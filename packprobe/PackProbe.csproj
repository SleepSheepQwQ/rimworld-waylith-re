<Project Sdk="Microsoft.NET.Sdk">

  <!-- packprobe: drives the SHIPPED asset-pack / VFS layer (dlls/Waylith.dll,
       dlls/UnityStubs.dll) with packs built by the SHIPPED AssetPackWriter, so every
       result below is the binary's own behaviour, not a re-implementation.
       No game, no Unity, no GPU, no Vulkan: pure managed types only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PackProbe</AssemblyName>
    <RootNamespace>PackProbe</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>CS0649;CS0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Waylith">
      <HintPath>../dlls/Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>../dlls/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="../dlls/*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

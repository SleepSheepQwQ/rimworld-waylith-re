<Project Sdk="Microsoft.NET.Sdk">

  <!-- A MINIMAL stand-in for dlls/UnityStubs.dll. The shipped one binds to the Waylith engine
       and its native Vulkan layer (Brutal.Vulkan.Abstractions), which is not in this repo, so a
       Texture2D cannot be allocated and Shader.Find cannot resolve a single shader; both failures
       are reproduced with stack traces by iconexec/UnityProbe first. This project declares only
       the UnityEngine surface that the icon path touches.

       AssemblyName/version must match what Assembly-CSharp references (UnityStubs 1.0.0.0). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>UnityStubs</AssemblyName>
    <RootNamespace>UnityEngine</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS0660;CS0661;CS0108</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Logging/**" />
    <ProjectReference Include="Logging/Logging.csproj" />
  </ItemGroup>

</Project>

          <li>Gun</li>
          <li>Sighted</li>
          <li>BurstFire</li>
          <li>LowStoppingPower</li>
          <li>Attachable</li>
        </weaponCategories>
        <namerLabels>
          <li>heavy SMG</li>
          <li>SMG</li>
          <li>chugger</li>

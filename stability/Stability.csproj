<Project Sdk="Microsoft.NET.Sdk">

  <!-- Metadata-only white-box harness for the icon-stability question.
       No game assembly is executed here: dlls/Assembly-CSharp.dll is read with
       System.Reflection.Metadata. The dynamic counterpart lives in iconexec/. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Stability</AssemblyName>
    <RootNamespace>Stability</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../iconexec/Asm.cs" Link="Asm.cs" />
    <Compile Include="../iconexec/Il.cs" Link="Il.cs" />
  </ItemGroup>

</Project>

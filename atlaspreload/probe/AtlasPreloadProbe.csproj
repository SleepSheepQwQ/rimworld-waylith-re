<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AtlasPreloadProbe</AssemblyName>
    <RootNamespace>AtlasPreloadProbe</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\dlls\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>..\..\dlls\UnityStubs.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Compile Include="..\Source\AtlasPreloadPolicy.cs" Link="AtlasPreloadPolicy.cs" />
    <Compile Include="..\Source\AtlasPreloadSelfTest.cs" Link="AtlasPreloadSelfTest.cs" />
  </ItemGroup>

</Project>

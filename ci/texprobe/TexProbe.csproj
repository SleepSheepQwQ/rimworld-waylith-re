<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Startup hook (DOTNET_STARTUP_HOOKS) for the texture decode/cache probe. It boots inside the
    real game process, so WaylithRuntime is configured (cache root, log) exactly as on device,
    then drives the two branches Verse.ModContentLoader.LoadTexture has:
        .dds -> Verse.ModDdsLoader.TryLoadDds
        else -> UnityEngine.Texture2D.LoadFromFile   (PngDecoder -> stb -> magenta placeholder)
    and the texture cache those two write through (GpuTextureService / TextureCacheStore).
    Every line is prefixed [TEXPROBE]; ci/texprobe/gate.py is the pass/fail gate.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TexProbe</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>../../dlls/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>../../dlls/UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>../../dlls/Waylith.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>

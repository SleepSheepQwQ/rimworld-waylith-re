<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Startup hook (DOTNET_STARTUP_HOOKS) that runs inside the real game process after
    PlayDataLoader reports boot completion: it asserts the loaded DefDatabase, builds a Map
    and asks Widgets.GetIconFor for the icon of a real unique-weapon def.
    The game assemblies are referenced from ../../dlls and never copied.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>HeadlessScenario</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>../../dlls/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>../../dlls/UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>../../dlls/Waylith.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Startup hook for .github/workflows/uniqueicon.yml.

    Measures one ThingDef per class the same way, inside the real host:
      graphicData -> Graphic type -> Graphic_Collection.subGraphics (count / names / masks)
      -> instance pick (Graphic_Random.SubGraphicFor(thing) = thingIDNumber % n)
      -> BuildableDef.uiIcon / uiIconMaterial (name, shader, GetPropertyCount, mainTexture)
      -> Widgets.GetIconFor(ThingDef) plus its opaque-texel fraction.

    Used four times in one boot: the real Odyssey def, a plain-`.dds` control fixture, the
    `.png.dds` leak fixture, and the same leak with the shipped DX10 mask shape.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>UniqueIconProbe</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>../dlls/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>../dlls/UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>../dlls/Waylith.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>

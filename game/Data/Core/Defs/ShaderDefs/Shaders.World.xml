<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ShaderDef>
    <defName>WorldTerrain</defName>
    <shaderProgram>
      <vertexShaderFileName>WorldTerrain.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>WorldTerrain.frag.glsl</fragmentShaderFileName>
      <stencilEnabled>true</stencilEnabled>
      <stencilCompare>Always</stencilCompare>
      <stencilPassOp>Replace</stencilPassOp>
      <stencilRef>3</stencilRef>
      <stencilWriteMask>3</stencilWriteMask>
      <textureWrapOverrides>
        <li>
          <key>_MainTex</key>
          <value>Repeat</value>
        </li>
        <li>
          <key>_SecondaryTex</key>
          <value>Repeat</value>
        </li>
        <li>
          <key>_MaskTex</key>
          <value>Clamp</value>
        </li>
        <li>
          <key>_MacroTex</key>
          <value>Repeat</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

  <ShaderDef>
    <defName>WorldOcean</defName>
    <shaderProgram>
      <fragmentShaderFileName>WorldOcean.frag.glsl</fragmentShaderFileName>
      <stencilEnabled>true</stencilEnabled>
      <stencilCompare>Always</stencilCompare>
      <stencilPassOp>Replace</stencilPassOp>
      <stencilRef>1</stencilRef>
      <stencilWriteMask>1</stencilWriteMask>
      <textureWrapOverrides>
        <li>
          <key>_MainTex</key>
          <value>Repeat</value>
        </li>
        <li>
          <key>_MacroTex</key>
          <value>Repeat</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

  <ShaderDef>
    <defName>UngeneratedPlanetParts</defName>
    <shaderProgram>
      <fragmentShaderFileName>UngeneratedPlanetParts.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
    </shaderProgram>
  </ShaderDef>

  <ShaderDef>
    <defName>WorldIce</defName>
    <shaderProgram>
      <vertexShaderFileName>WorldTerrain.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>WorldTerrain.frag.glsl</fragmentShaderFileName>
      <textureWrapOverrides>
        <li>
          <key>_MainTex</key>
          <value>Repeat</value>
        </li>
        <li>
          <key>_SecondaryTex</key>
          <value>Repeat</value>
        </li>
        <li>
          <key>_MaskTex</key>
          <value>Clamp</value>
        </li>
        <li>
          <key>_MacroTex</key>
          <value>Repeat</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

  <ShaderDef>
    <defName>WorldOverlayAdditive</defName>
    <shaderProgram>
      <fragmentShaderFileName>WorldOverlay.frag.glsl</fragmentShaderFileName>
      <blendMode>Additive</blendMode>
      <depthWrite>false</depthWrite>
      <renderQueue>Transparent</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <ShaderDef>
    <defName>WorldOverlayAdditiveTwoSided</defName>
    <shaderProgram>
      <fragmentShaderFileName>WorldOverlay.frag.glsl</fragmentShaderFileName>
      <blendMode>Additive</blendMode>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>Transparent</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <ShaderDef>
    <defName>WorldOverlayTransparent</defName>
    <shaderProgram>
      <fragmentShaderFileName>WorldOverlay.frag.glsl</fragmentShaderFileName>
      <transparent>true</transparent>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>Transparent</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <ShaderDef>
    <defName>WorldOverlayTransparentLit</defName>
    <shaderProgram>
      <fragmentShaderFileName>WorldOverlayLit.frag.glsl</fragmentShaderFileName>
      <transparent>true</transparent>
    </shaderProgram>
  </ShaderDef>

  <ShaderDef>

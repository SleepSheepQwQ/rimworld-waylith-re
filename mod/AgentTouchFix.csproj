<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AgentTouchFix</AssemblyName>
    <RootNamespace>AgentTouchFix</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>1.7.0</Version>
    <AssemblyVersion>1.7.0.0</AssemblyVersion>
    <FileVersion>1.7.0.0</FileVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <!-- .NET 8+ appends "+<git sha>" to AssemblyInformationalVersion, which made every commit
         produce a different DLL (same size, different bytes) and invalidated the hashes recorded
         in BUILD.md. The binary must depend on the source only. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Optimize>true</Optimize>
    <!-- referenced game assemblies are net10.0 too, they just carry no reference assembly -->
    <NoWarn>$(NoWarn);CS1701;CS1702;MSB3277;MSB3245</NoWarn>
  </PropertyGroup>

  <!-- Reference assemblies are NOT shipped; the game loads them itself. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(MSBuildThisFileDirectory)..\dlls\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MSBuildThisFileDirectory)..\dlls\0Harmony.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
  </ItemGroup>

</Project>

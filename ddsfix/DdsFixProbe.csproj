<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Startup hook for .github/workflows/ddsfix.yml.

    It compiles the probe source that lives in modcheck/StartupHook.cs into its own assembly, so the
    DDS gate does not depend on modcheck's project file (that workflow may be reorganised without
    touching this one) and so DOTNET_STARTUP_HOOKS gets a single, self-contained DLL. The hook type is
    `StartupHook` in the global namespace with a static Initialize(), which is what the runtime looks
    for; the source keeps the [MODCHECK] line prefix because that is the format the gate parses.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>DdsFixProbe</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../modcheck/StartupHook.cs" Link="StartupHook.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>../dlls/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>../dlls/UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>../dlls/Waylith.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
